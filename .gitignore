# ==== Datos y salidas (NO subir documentos institucionales) ====
# Todo el contenido de datos/ (CSV, XLSX, etc. con datos reales)
datos/*
# Carpetas de descarga (PDFs de documentos institucionales)
salida/
salida_interna/
# Pero conservar la estructura de carpeta vacía
!datos/.gitkeep

# ==== Python ====
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ==== Node ====
node_modules/
npm-debug.log*

# ==== Sistema / editor ====
.DS_Store
Thumbs.db
.vscode/
*.log

# ==== Seguridad: nunca subir credenciales ====
# Si alguna vez guardas la cookie en un archivo aparte:
*.secret
cookie.txt
.env
